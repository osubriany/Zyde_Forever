<Bindings>
	<Binding name="CLICK ZydeForeverFishButton:LeftButton" category="Zyde Forever">
		-- Handled by the secure button ZydeForeverFishButton in Zyde_Forever.lua
	</Binding>
	<Binding name="CLICK ZydeForeverQuestMobTarget:LeftButton" category="Zyde Forever">
	</Binding>
	<Binding name="CLICK ZydeForeverFeedPet:LeftButton" category="Zyde Forever">
	</Binding>
	<Binding name="CLICK ZydeForeverCallPet:LeftButton" category="Zyde Forever">
	</Binding>
	<Binding name="CLICK ZydeForeverMarkerKey:LeftButton" category="Zyde Forever">
	</Binding>
	<Binding name="CLICK ZydeForeverWorldMarkerKey:LeftButton" category="Zyde Forever">
	</Binding>
	<Binding name="CLICK ZydeForeverRadialKey:RightButton" category="Zyde Forever">
		-- Hold: the radial ring (Radial.lua). Let go over a slot to use it.
		-- Right button, same as a bag right-click, so a bandage heals your target.
	</Binding>
	<Binding name="CLICK ZydeForeverButtonBagKey:LeftButton" category="Zyde Forever">
	</Binding>
	<Binding name="CLICK LevelPlannerItemButton:LeftButton" category="Zyde Forever">
		-- Level planner: uses the current quest's item (secure button LevelPlannerItemButton)
	</Binding>
	<Binding name="CLICK ZydeForeverMountKey:LeftButton" category="Zyde Forever">
		-- Summons a random favorite mount (Mounts.lua).
	</Binding>
	<Binding name="CLICK LevelPlannerTargetNPC:LeftButton" category="Zyde Forever">
		-- Level planner: targets the next step's NPC and stars it (secure button LevelPlannerTargetNPC)
	</Binding>
</Bindings>
